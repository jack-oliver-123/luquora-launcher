{
  "name": "luquora-launcher",
  "version": "0.2.0",
  "description": "Luquora Launcher — Minecraft Java Edition launcher for Windows",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "electron-vite build",
    "pack:dir": "npm run build && electron-builder --dir --win --x64",
    "dist:win": "npm run notices && npm run build && electron-builder --win nsis --x64",
    "dist:portable": "npm run notices && npm run build && electron-builder --config electron-builder.portable.yml --win portable --x64",
    "notices": "node scripts/third-party-notices.mjs",
    "test:live": "vitest run tests/live/acceptance.test.ts"
  },
  "dependencies": {
    "@azure/msal-node": "7.2.2",
    "@vicons/ionicons5": "^0.13.0",
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "@xmcl/user": "4.4.2",
    "naive-ui": "2.45.3",
    "vue": "3.5.45",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "@xmcl/unzip": {
      "yauzl": "3.4.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-vue": "6.0.11",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "yazl": "3.3.1"
  }
}
